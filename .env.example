# Copy to .env. The Google Cloud project that runs Gemini on Vertex AI (your own course project).
# Auth: `gcloud auth application-default login` (the same credentials also read the data bucket).
VERTEXAI_PROJECT=
VERTEX_LOCATION=global
# Optional overrides
# LEAD_MODEL=vertex_ai/gemini-3.6-flash          # also the Clarifier and Writer
# RESEARCHER_MODEL=vertex_ai/gemini-3.6-flash
# CHECK_MODEL=vertex_ai/gemini-3.5-flash-lite     # the off-topic check
# LEAD_EFFORT=high                                # also CLARIFIER_EFFORT, RESEARCHER_EFFORT, WRITER_EFFORT
# MAX_RESEARCHERS=8
# MAX_ROUNDS=3
# Data bucket (data_pipeline/db.py)
# GCS_BUCKET=mlb-agent-2026
# GCS_DATA_VERSION=v3
